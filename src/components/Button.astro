---
interface Props {
  href: string;
  variant?: 'solid' | 'outline' | 'link';
  size?: 'md' | 'lg';
  class?: string;
}

const {
  href,
  variant = 'solid',
  size = 'md',
  class: className = '',
} = Astro.props;

const base = 'inline-flex items-center justify-center gap-2 font-body font-medium';

/*
  The pill variants carry their motion in the .btn layer (global.css);
  only `link` stays a plain text affordance, so it keeps its own hover.
*/
const variants = {
  solid: 'btn btn-solid rounded-full bg-forest text-cream',
  outline: 'btn btn-outline rounded-full border border-forest/25 text-forest',
  link: 'text-forest underline-offset-4 transition-colors duration-200 hover:underline',
};

const sizes = {
  md: variant === 'link' ? 'text-base' : 'px-7 py-3 text-[0.95rem]',
  lg: variant === 'link' ? 'text-lg' : 'px-9 py-4 text-base',
};
---

<a href={href} class={`${base} ${variants[variant]} ${sizes[size]} ${className}`}>
  <slot />
  {
    variant === 'link' && (
      <span aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-1">
        →
      </span>
    )
  }
</a>
