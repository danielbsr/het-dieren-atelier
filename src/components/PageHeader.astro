---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
}

const { eyebrow, title, intro } = Astro.props;
---

<div class="mx-auto max-w-[75rem] px-6 pb-4 pt-16 md:px-10 md:pb-8 md:pt-28">
  {eyebrow && <p class="eyebrow" data-reveal="rise">{eyebrow}</p>}
  <h1 class="mt-5 max-w-[18ch] text-page leading-[1.02] text-ink" data-reveal="line">
    {title}
  </h1>
  {
    intro && (
      <p
        class="mt-7 max-w-[40rem] font-body text-lg leading-relaxed text-muted md:text-xl"
        data-reveal="rise"
      >
        {intro}
      </p>
    )
  }
</div>
