---
/**
 * Studio location.
 *
 * The real address is still TO BE SUPPLIED, so this renders a styled
 * stand-in rather than pointing at a wrong location. To go live, replace
 * the inner block with an iframe, e.g.
 *
 *   <iframe src="https://www.openstreetmap.org/export/embed.html?bbox=…&marker=…"
 *           title="Studio location" loading="lazy" class="h-full w-full" />
 */
interface Props {
  class?: string;
  label?: string;
}

const { class: className = '', label = 'Studio location' } = Astro.props;
---

<div
  class={`relative overflow-hidden bg-cream-deep ${className}`}
  role="img"
  aria-label={`${label} — map placeholder, address to be supplied`}
>
  <!-- Abstract street grid, so the block reads as a map without faking one. -->
  <svg class="absolute inset-0 h-full w-full text-forest/12" aria-hidden="true">
    <defs>
      <pattern id="map-grid" width="46" height="46" patternUnits="userSpaceOnUse">
        <path d="M46 0V46M0 46H46" stroke="currentColor" stroke-width="1" fill="none"></path>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#map-grid)"></rect>
    <path
      d="M-20 118 L420 58"
      stroke="currentColor"
      stroke-width="9"
      fill="none"
      opacity="0.7"></path>
    <path d="M132 -20 L172 320" stroke="currentColor" stroke-width="6" fill="none" opacity="0.5"
    ></path>
  </svg>

  <div class="absolute inset-0 flex flex-col items-center justify-center gap-2 text-center">
    <svg width="20" height="26" viewBox="0 0 20 26" fill="none" aria-hidden="true">
      <path
        d="M10 25s8.5-9.3 8.5-15A8.5 8.5 0 0 0 1.5 10c0 5.7 8.5 15 8.5 15Z"
        fill="#1d3b2e"></path>
      <circle cx="10" cy="10" r="3.1" fill="#a9c93c"></circle>
    </svg>
    <span class="px-4 font-body text-xs tracking-wide text-muted"> Map — address to be supplied </span>
  </div>
</div>
