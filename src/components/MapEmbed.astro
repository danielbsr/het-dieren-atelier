---
import { STUDIO } from '../data/site';

/**
 * The studio on the map.
 *
 * Google's keyless `output=embed` endpoint, so there is no API key to
 * keep alive and no billing account attached to a map that only ever
 * shows one address. The pin is placed by address string — if the
 * studio ever moves, STUDIO.address is the only thing to change.
 */
interface Props {
  class?: string;
  /** Adds the "Open in Google Maps" link under the frame. */
  link?: boolean;
}

const { class: className = '', link = false } = Astro.props;
---

<div>
  <div class={`relative overflow-hidden bg-cream-deep ${className}`}>
    <iframe
      src={STUDIO.mapsEmbedUrl}
      title={`Map showing ${STUDIO.name}, ${STUDIO.address}`}
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      class="h-full w-full border-0"
      style="filter:saturate(0.82) contrast(1.02)"
    ></iframe>
  </div>

  {
    link && (
      <a
        href={STUDIO.mapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="group mt-3 inline-flex items-center gap-2 font-body text-sm text-forest underline-offset-4 hover:underline"
      >
        <svg width="13" height="17" viewBox="0 0 20 26" fill="none" aria-hidden="true">
          <path
            d="M10 25s8.5-9.3 8.5-15A8.5 8.5 0 0 0 1.5 10c0 5.7 8.5 15 8.5 15Z"
            fill="currentColor"></path>
          <circle cx="10" cy="10" r="3.1" fill="#a9c93c"></circle>
        </svg>
        Open in Google Maps
        <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
      </a>
    )
  }
</div>
