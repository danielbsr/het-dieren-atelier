---
import { STUDIO } from '../data/site';

/**
 * De studio op de kaart.
 *
 * Google's sleutelloze `output=embed`-endpoint, dus geen API-sleutel om
 * in leven te houden en geen factuuraccount aan een kaart die maar één
 * adres laat zien. De speld staat op de adresregel — verhuist de studio
 * ooit, dan is STUDIO.address het enige dat verandert.
 *
 * De iframe krijgt zijn `src` pas nadat iemand externe inhoud heeft
 * toegestaan (zie <CookieConsent />), want Google plaatst cookies. Tot
 * die tijd staat er een vlak met een knop die de kaart alsnog laadt —
 * één klik, zonder dat de keuze voor de hele site verandert. Het adres
 * en de link naar Google Maps staan eromheen, dus de route is ook
 * zonder kaart te vinden.
 */
interface Props {
  class?: string;
  /** Zet de link "Open in Google Maps" onder het kader. */
  link?: boolean;
}

const { class: className = '', link = false } = Astro.props;
---

<div>
  <div class={`relative overflow-hidden bg-cream-deep ${className}`}>
    <iframe
      data-consent-src={STUDIO.mapsEmbedUrl}
      title={`Kaart met ${STUDIO.name}, ${STUDIO.address}`}
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      class="h-full w-full border-0"
      style="filter:saturate(0.82) contrast(1.02)"></iframe>

    <!-- Verdwijnt zodra de iframe een src heeft. -->
    <div
      class="absolute inset-0 flex flex-col items-center justify-center gap-3 p-5 text-center"
      data-map-placeholder
    >
      <p class="max-w-[22rem] font-body text-[0.8rem] leading-relaxed text-muted">
        De kaart van Google Maps laadt pas als je externe inhoud toestaat.
      </p>
      <button
        type="button"
        data-map-load
        class="btn btn-outline rounded-full border border-forest/25 px-5 py-2 font-body text-[0.8rem] font-medium text-forest"
      >
        Kaart tonen
      </button>
    </div>
  </div>

  {
    link && (
      <a
        href={STUDIO.mapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="group mt-3 inline-flex items-center gap-2 font-body text-sm text-forest underline-offset-4 hover:underline"
      >
        <svg width="13" height="17" viewBox="0 0 20 26" fill="none" aria-hidden="true">
          <path
            d="M10 25s8.5-9.3 8.5-15A8.5 8.5 0 0 0 1.5 10c0 5.7 8.5 15 8.5 15Z"
            fill="currentColor"></path>
          <circle cx="10" cy="10" r="3.1" fill="#a9c93c"></circle>
        </svg>
        Open in Google Maps
        <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
      </a>
    )
  }
</div>

<script>
  /*
    "Kaart tonen" laadt alleen deze kaart, voor dit bezoek. Dat is
    bewust geen site-brede toestemming: iemand die één keer de route wil
    zien heeft niet gezegd dat alle externe inhoud voortaan mag. Voor dat
    laatste is er het toestemmingsvenster.
  */
  for (const button of document.querySelectorAll<HTMLElement>('[data-map-load]')) {
    button.addEventListener('click', () => {
      const frame = button.closest('div.relative')?.querySelector('iframe');
      if (!frame || frame.getAttribute('src')) return;
      frame.setAttribute('src', frame.dataset.consentSrc!);
      button.closest<HTMLElement>('[data-map-placeholder]')?.setAttribute('hidden', '');
    });
  }
</script>
