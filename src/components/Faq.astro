---
/**
 * Accordion built on native <details>/<summary>: keyboard-accessible,
 * findable by in-page search, and works without JavaScript.
 */
interface Props {
  items: { q: string; a: string }[];
  class?: string;
}

const { items, class: className = '' } = Astro.props;
---

<div class={`divide-y divide-line border-y border-line ${className}`}>
  {
    items.map((item) => (
      <details class="group" data-reveal="rise">
        <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-6 font-display text-xl text-ink transition-colors hover:text-forest md:text-[1.4rem]">
          {item.q}
          <span
            aria-hidden="true"
            class="mt-1.5 shrink-0 text-forest transition-transform duration-300 group-open:rotate-45"
          >
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M8 1v14M1 8h14" stroke="currentColor" stroke-width="1.5" />
            </svg>
          </span>
        </summary>
        <p class="max-w-[46rem] pb-7 font-body text-[1.05rem] leading-relaxed text-muted">
          {item.a}
        </p>
      </details>
    ))
  }
</div>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>
