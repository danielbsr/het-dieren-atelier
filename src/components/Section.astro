---
/**
 * Section rhythm is spacing, never background colour. Padding stays
 * generous at every breakpoint — the brand rests on unhurried space.
 */
interface Props {
  id?: string;
  width?: 'text' | 'grid' | 'full';
  space?: 'normal' | 'tight' | 'loose';
  class?: string;
}

const {
  id,
  width = 'grid',
  space = 'normal',
  class: className = '',
} = Astro.props;

const spaces = {
  tight: 'py-14 md:py-20',
  normal: 'py-16 md:py-28 lg:py-36',
  loose: 'py-20 md:py-36 lg:py-44',
};

const widths = {
  text: 'mx-auto w-full max-w-[40rem] px-6',
  grid: 'mx-auto w-full max-w-[75rem] px-6 md:px-10',
  full: 'w-full',
};
---

<section id={id} class={`${spaces[space]} ${className}`}>
  <div class={widths[width]}>
    <slot />
  </div>
</section>
