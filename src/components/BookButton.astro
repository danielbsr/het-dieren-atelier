---
import { CTA } from '../data/site';

/**
 * De boekknop. Het enige op de site dat naar Calendly linkt.
 *
 * Hij verschijnt na elke sectie die in een beslissing kan eindigen,
 * zodat niemand ooit terug hoeft te scrollen om hem te vinden. Eén
 * label, één bestemming, één uiterlijk — die herhaling is wat hem laat
 * lezen als de vanzelfsprekende volgende stap in plaats van als zes
 * verschillende aanbiedingen.
 *
 * Boeken gebeurt op andermans domein, dus hij opent in een nieuw tabblad
 * en zegt dat ook tegen schermlezers.
 */
interface Props {
  variant?: 'solid' | 'outline';
  size?: 'md' | 'lg';
  /** Volle breedte onder `sm`. Een halve CTA op een telefoon is een gemiste tik. */
  block?: boolean;
  label?: string;
  class?: string;
}

const {
  variant = 'solid',
  size = 'lg',
  block = false,
  label = CTA.book.label,
  class: className = '',
} = Astro.props;

const variants = {
  solid: 'btn btn-solid bg-forest text-cream',
  outline: 'btn btn-outline border border-forest/25 text-forest',
};

const sizes = {
  md: 'px-7 py-3.5 text-[0.95rem]',
  lg: 'px-9 py-4 text-base',
};

const width = block
  ? 'flex w-full sm:inline-flex sm:w-auto'
  : 'inline-flex';
---

<a
  href={CTA.book.href}
  target="_blank"
  rel="noopener noreferrer"
  class={`${width} items-center justify-center rounded-full text-center font-body font-medium ${variants[variant]} ${sizes[size]} ${className}`}
>
  {label}
  <span class="sr-only"> (opent de boekingsagenda in een nieuw tabblad)</span>
</a>
