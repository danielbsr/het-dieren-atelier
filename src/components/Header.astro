---
import Logo from './Logo.astro';
import { NAV, CTA, withBase, stripBase } from '../data/site';

// Compare both sides base-free, so the active link survives a subfolder deploy.
const path = stripBase(Astro.url.pathname);
const nav = NAV.map((item) => ({ ...item, current: stripBase(item.href) === path }));
---

<header
  id="site-header"
  class="sticky top-0 z-50 border-b border-transparent bg-cream/85 backdrop-blur-md transition-[border-color,background-color] duration-300 data-[scrolled]:border-line"
>
  <div
    class="mx-auto flex max-w-[75rem] items-center justify-between gap-8 px-6 py-5 transition-[padding] duration-300 md:px-10 data-[scrolled]:py-3"
    id="site-header-inner"
  >
    <a href={withBase('/')} class="shrink-0" aria-label="Het Dieren Atelier — home">
      <Logo class="text-[1.05rem] md:text-[1.15rem]" />
    </a>

    <nav class="hidden items-center gap-8 lg:flex" aria-label="Main">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={item.current ? 'page' : undefined}
            class="relative py-1 font-body text-[0.925rem] text-ink/75 transition-colors hover:text-forest aria-[current=page]:text-forest"
          >
            {item.label}
            {item.current && (
              <span class="absolute inset-x-0 -bottom-0.5 h-px bg-lime" aria-hidden="true" />
            )}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={CTA.book.href}
        class="hidden rounded-full bg-forest px-6 py-2.5 font-body text-[0.9rem] font-medium text-cream transition-colors hover:bg-forest-deep sm:inline-flex"
      >
        {CTA.book.label}
      </a>

      <button
        type="button"
        id="menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="flex h-10 w-10 items-center justify-center rounded-full border border-forest/20 text-forest lg:hidden"
      >
        <span class="sr-only">Open menu</span>
        <svg width="18" height="12" viewBox="0 0 18 12" fill="none" aria-hidden="true">
          <path d="M0 1h18M0 6h18M0 11h18" stroke="currentColor" stroke-width="1.4"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    hidden
    class="border-t border-line bg-cream px-6 pb-8 pt-4 lg:hidden"
  >
    <nav class="flex flex-col" aria-label="Mobile">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="border-b border-line/70 py-4 font-display text-2xl text-ink transition-colors hover:text-forest"
          >
            {item.label}
          </a>
        ))
      }
      <a href={CTA.book.href} class="py-4 font-display text-2xl text-forest">
        {CTA.book.label}
      </a>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const inner = document.getElementById('site-header-inner');
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  // Compress the header on scroll — the CTA never disappears.
  const onScroll = () => {
    const scrolled = window.scrollY > 24;
    for (const el of [header, inner]) {
      if (!el) continue;
      if (scrolled) el.setAttribute('data-scrolled', '');
      else el.removeAttribute('data-scrolled');
    }
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  toggle?.addEventListener('click', () => {
    if (!menu) return;
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    menu.hidden = open;
  });
</script>
