---
import BookButton from './BookButton.astro';
import { EXTRA_PORTRAIT, FEATURED_LABEL, ON_LOCATION, PACKAGES } from '../data/site';

/**
 * De drie studiopakketten, en — eronder, in dezelfde taal — de optie
 * waarbij de studio reist in plaats van het dier.
 *
 * Het Locatieportret is bewust geen vierde kolom: het is anders geprijsd,
 * duurt langer, en een rij van vier zou de drie die het al doen
 * platdrukken. Eén brede kaart leest als "en dit kan ook", en dat is
 * precies wat het is.
 */
interface Props {
  /** Uit op pagina's die het apart behandelen. */
  onLocation?: boolean;
  /** De boekknop direct onder de opties. */
  cta?: boolean;
  class?: string;
}

const { onLocation = true, cta = true, class: className = '' } = Astro.props;

const check = 'M1 7.5 5 11.5 13 2.5';
---

<div class={className}>
  <div class="grid items-start gap-8 md:grid-cols-3 md:gap-5">
    {
      PACKAGES.map((pkg) => (
        <article
          data-reveal="rise"
          class={
            pkg.featured
              ? 'card-hover relative flex h-full flex-col rounded-2xl border-2 border-forest bg-cream p-7 md:-mt-4 md:p-9'
              : 'card-hover relative flex h-full flex-col rounded-2xl border border-line bg-cream p-7 hover:border-forest/30 md:p-8'
          }
        >
          {pkg.featured && (
            <span class="absolute -top-3 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-full bg-lime px-4 py-1 font-body text-[0.7rem] font-medium uppercase tracking-[0.14em] text-forest-deep">
              {FEATURED_LABEL}
            </span>
          )}

          <h3 class="font-display text-2xl text-ink">{pkg.name}</h3>
          <p class="mt-1 font-display text-[2.25rem] leading-none text-forest md:text-[2.5rem]">
            {pkg.price}
          </p>
          <p class="mt-4 font-body text-sm leading-relaxed text-muted">{pkg.blurb}</p>

          <ul class="mt-6 space-y-3 border-t border-line pt-6 md:mt-7 md:pt-7">
            {pkg.highlights.map((line) => (
              <li class="flex gap-3 font-body text-[0.95rem] text-ink/85">
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 14 14"
                  fill="none"
                  class="mt-1.5 shrink-0 text-forest"
                  aria-hidden="true"
                >
                  <path
                    d={check}
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
                {line}
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>

  <p
    class="mt-8 text-center font-body text-[0.95rem] text-muted md:mt-10"
    data-reveal="rise"
  >
    {EXTRA_PORTRAIT.label}: <span class="text-ink">{EXTRA_PORTRAIT.price}</span>
  </p>

  {
    onLocation && (
      <article
        data-reveal="rise"
        class="card-hover relative mt-10 rounded-2xl border border-line bg-cream p-7 hover:border-forest/30 md:mt-14 md:p-10"
      >
        <span class="absolute -top-3 left-7 whitespace-nowrap rounded-full bg-forest px-4 py-1 font-body text-[0.7rem] font-medium uppercase tracking-[0.14em] text-cream md:left-10">
          {ON_LOCATION.eyebrow}
        </span>

        <div class="grid gap-7 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] md:gap-14">
          <div>
            <h3 class="font-display text-2xl text-ink md:text-[1.9rem]">{ON_LOCATION.name}</h3>
            <p class="mt-2 font-display text-[1.9rem] leading-none text-forest md:text-[2.25rem]">
              {ON_LOCATION.price}
            </p>
            <p class="mt-4 max-w-[30rem] font-body text-[1.05rem] leading-relaxed text-ink">
              {ON_LOCATION.blurb}
            </p>
            <p class="mt-3 max-w-[30rem] font-body text-[0.95rem] leading-relaxed text-muted">
              {ON_LOCATION.intro}
            </p>
          </div>

          <ul class="space-y-3 border-t border-line pt-6 md:border-l md:border-t-0 md:pl-14 md:pt-0">
            {ON_LOCATION.highlights.map((line) => (
              <li class="flex gap-3 font-body text-[0.95rem] text-ink/85">
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 14 14"
                  fill="none"
                  class="mt-1.5 shrink-0 text-forest"
                  aria-hidden="true"
                >
                  <path
                    d={check}
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
                {line}
              </li>
            ))}
            <li class="flex gap-3 pt-2 font-body text-[0.85rem] leading-relaxed text-muted">
              <svg
                width="14"
                height="14"
                viewBox="0 0 16 16"
                fill="none"
                class="mt-0.5 shrink-0 text-muted"
                aria-hidden="true"
              >
                <circle cx="8" cy="8" r="6.6" stroke="currentColor" stroke-width="1.4" />
                <path
                  d="M8 7.2v4M8 4.9v.1"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                />
              </svg>
              {ON_LOCATION.priceNote}
            </li>
          </ul>
        </div>
      </article>
    )
  }

  {
    cta && (
      <div class="mt-10 text-center md:mt-14" data-reveal="rise">
        <BookButton block />
      </div>
    )
  }
</div>
