---
import BookButton from './BookButton.astro';
import { ON_LOCATION, PACKAGES } from '../data/site';

/**
 * The three studio packages, and — underneath, in the same language —
 * the one option where the studio travels instead of the animal.
 *
 * The on-location session is deliberately not a fourth column: it is
 * priced differently, lasts differently, and a four-across row would
 * squeeze the three that are already working. One wide card reads as
 * "and also this", which is exactly what it is.
 */
interface Props {
  /** Off on pages that list it separately. */
  onLocation?: boolean;
  /** The booking button directly under the options. */
  cta?: boolean;
  class?: string;
}

const { onLocation = true, cta = true, class: className = '' } = Astro.props;

const check =
  'M1 7.5 5 11.5 13 2.5';
---

<div class={className}>
  <div class="grid items-center gap-8 md:grid-cols-3 md:gap-5">
    {
      PACKAGES.map((pkg) => (
        <article
          data-reveal="rise"
          class={
            pkg.featured
              ? 'card-hover relative rounded-2xl border-2 border-forest bg-cream p-7 md:-my-4 md:p-9'
              : 'card-hover relative rounded-2xl border border-line bg-cream p-7 hover:border-forest/30 md:p-8'
          }
        >
          {pkg.featured && (
            <span class="absolute -top-3 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-full bg-lime px-4 py-1 font-body text-[0.7rem] font-medium uppercase tracking-[0.14em] text-forest-deep">
              Most chosen
            </span>
          )}

          <h3 class="font-display text-2xl text-ink">{pkg.name}</h3>
          <p class="mt-1 font-display text-[2.25rem] leading-none text-forest md:text-[2.5rem]">
            {pkg.price}
          </p>
          <p class="mt-4 font-body text-sm leading-relaxed text-muted">{pkg.blurb}</p>

          <ul class="mt-6 space-y-3 border-t border-line pt-6 md:mt-7 md:pt-7">
            {pkg.highlights.map((line) => (
              <li class="flex gap-3 font-body text-[0.95rem] text-ink/85">
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 14 14"
                  fill="none"
                  class="mt-1.5 shrink-0 text-forest"
                  aria-hidden="true"
                >
                  <path
                    d={check}
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
                {line}
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>

  {
    onLocation && (
      <article
        data-reveal="rise"
        class="card-hover relative mt-8 rounded-2xl border border-line bg-cream p-7 hover:border-forest/30 md:mt-14 md:p-10"
      >
        <span class="absolute -top-3 left-7 whitespace-nowrap rounded-full bg-forest px-4 py-1 font-body text-[0.7rem] font-medium uppercase tracking-[0.14em] text-cream md:left-10">
          {ON_LOCATION.eyebrow}
        </span>

        <div class="grid gap-7 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] md:gap-14">
          <div>
            <h3 class="font-display text-2xl text-ink md:text-[1.9rem]">{ON_LOCATION.name}</h3>
            <p class="mt-2 font-display text-[1.6rem] leading-none text-forest md:text-[1.9rem]">
              {ON_LOCATION.price}
            </p>
            <p class="mt-4 max-w-[30rem] font-body text-sm leading-relaxed text-muted">
              {ON_LOCATION.blurb}
            </p>
            <p class="mt-4 max-w-[30rem] font-body text-[0.95rem] leading-relaxed text-ink/70">
              {ON_LOCATION.guidance}
            </p>
          </div>

          <ul class="space-y-3 border-t border-line pt-6 md:border-l md:border-t-0 md:pl-14 md:pt-0">
            {ON_LOCATION.highlights.map((line) => (
              <li class="flex gap-3 font-body text-[0.95rem] text-ink/85">
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 14 14"
                  fill="none"
                  class="mt-1.5 shrink-0 text-forest"
                  aria-hidden="true"
                >
                  <path
                    d={check}
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
                {line}
              </li>
            ))}
            <li class="pt-2 font-body text-[0.8rem] leading-relaxed text-ink/40">
              {ON_LOCATION.priceNote}
            </li>
          </ul>
        </div>
      </article>
    )
  }

  {
    cta && (
      <div class="mt-10 text-center md:mt-14" data-reveal="rise">
        <BookButton block />
      </div>
    )
  }
</div>
