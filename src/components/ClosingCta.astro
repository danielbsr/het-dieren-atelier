---
import Portrait from './Portrait.astro';
import BookButton from './BookButton.astro';
import { photo } from '../data/photos';
import { type BackdropKey } from '../data/site';

/**
 * Het afsluitblok. Een portret met direct oogcontact staat naast de
 * beslissing — oogcontact op het moment van kiezen trekt de aandacht
 * precies hierheen.
 */
interface Props {
  headline: string;
  body?: string;
  tone?: BackdropKey;
  animal?: 'dog' | 'cat' | 'rabbit' | 'bird' | 'guineapig';
  /** Korte omschrijving van het dier, voor de alt-tekst. */
  subject?: string;
  /** Bestandsnaam in src/assets/portraits. Elke pagina sluit op een ander gezicht. */
  photo?: string;
}

const {
  headline,
  body = 'Kies een datum in de agenda — de rest gebeurt rustig, in de studio.',
  tone = 'pearl',
  animal = 'dog',
  subject,
  photo: photoSlot,
} = Astro.props;
---

<section class="border-t border-line">
  <div
    class="mx-auto grid max-w-[75rem] items-center gap-12 px-6 py-16 md:grid-cols-2 md:gap-20 md:px-10 md:py-32"
  >
    <Portrait
      tone={tone}
      animal={animal}
      subject={subject}
      src={photo(photoSlot)}
      sizes="(min-width: 768px) 448px, 100vw"
      ratio="portrait"
      class="max-w-md"
    />

    <div>
      <h2 class="text-close leading-[1.05] text-ink" data-reveal="line">{headline}</h2>
      <p class="mt-6 max-w-[34rem] font-body text-lg leading-relaxed text-muted" data-reveal="rise">
        {body}
      </p>
      <div class="mt-9" data-reveal="rise">
        <BookButton block />
      </div>
    </div>
  </div>
</section>
