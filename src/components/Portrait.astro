---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import AnimalSilhouette from './AnimalSilhouette.astro';
import { ANIMAL_NOUN, BACKDROPS, type BackdropKey } from '../data/site';

/**
 * Een studioportret op een met de hand gekozen achtergrond.
 *
 * Zolang `src` ontbreekt rendert de getinte placeholder, zodat layout,
 * uitsnede en kleurcuratie nu al te beoordelen zijn. Al het andere
 * (bijschrift, verhouding, kleurnaam) blijft identiek.
 */
interface Props {
  tone: BackdropKey;
  name?: string;
  /**
   * Een import uit src/assets (meestal via `photo()`), die de build
   * herschaalt en hercodeert naar WebP. Een gewone string gaat
   * onbewerkt door naar <img>, voor alles wat al in public/ staat.
   */
  src?: ImageMetadata | string;
  alt?: string;
  animal?: 'dog' | 'cat' | 'rabbit' | 'bird' | 'guineapig';
  /** Korte omschrijving van het dier, bv. 'border collie' — voor de alt-tekst. */
  subject?: string;
  ratio?: 'tall' | 'portrait' | 'square' | 'wide' | 'banner';
  /**
   * Verhouding onder `md`. Telefoons zijn één kolom breed: een 3/4.4
   * portret dat op een desktopkolom zelfverzekerd oogt, vreet een heel
   * telefoonscherm op — dus de lange uitsnedes worden korter in plaats
   * van langer te scrollen.
   */
  mobileRatio?: 'tall' | 'portrait' | 'square' | 'wide' | 'banner';
  /** 'tight' zoomt het onderwerp in, zoals een close-up van een kop. Alleen voor de placeholder. */
  crop?: 'tight' | 'full';
  /**
   * Waar de uitsnede vandaan komt als het kader een andere verhouding
   * heeft dan het bestand. Standaard iets boven het midden: de dieren
   * staan gecentreerd in het beeld, dus bij een vierkante uitsnede van
   * een 4:5-bron moet de hap uit de poten komen en niet uit de kop
   * (punt 8 en 22 van de feedback).
   */
  objectPosition?: string;
  caption?: boolean;
  /** Langzame zoom onder de cursor. Voor grids; nooit voor de hero. */
  hover?: boolean;
  /**
   * Hoe breed deze plek rendert, zodat de browser het kleinste bestand
   * kan kiezen dat nog scherp is. De standaard past bij de twee- en
   * driekoloms grids; de hero en de brede blokken overschrijven hem.
   */
  sizes?: string;
  /** Boven de vouw: direct laden in plaats van lazy. */
  priority?: boolean;
  class?: string;
  /** Extra attributen (bv. data-species) landen op de <figure>. */
  [key: string]: unknown;
}

const {
  tone,
  name,
  src,
  alt,
  animal = 'dog',
  subject,
  ratio = 'portrait',
  mobileRatio,
  crop = 'full',
  objectPosition = '50% 38%',
  caption = false,
  hover = false,
  sizes = '(min-width: 1024px) 480px, (min-width: 768px) 45vw, 50vw',
  priority = false,
  class: className = '',
  ...rest
} = Astro.props;

/**
 * Kandidaatbreedtes. Niets op deze site rendert een foto breder dan
 * ~640 CSS px, dus 1440 is het 2×-plafond voor de grootste plek; Astro
 * laat elke kandidaat vallen die groter is dan het bronbestand.
 */
const WIDTHS = [320, 480, 640, 960, 1280, 1440];

const backdrop = BACKDROPS[tone];

const ratios = {
  tall: 'aspect-[3/4.4]',
  portrait: 'aspect-[4/5]',
  square: 'aspect-square',
  wide: 'aspect-[16/9]',
  banner: 'aspect-[21/8]',
};

const mdRatios = {
  tall: 'md:aspect-[3/4.4]',
  portrait: 'md:aspect-[4/5]',
  square: 'md:aspect-square',
  wide: 'md:aspect-[16/9]',
  banner: 'md:aspect-[21/8]',
};

// Zonder mobiele override geldt de ene verhouding op elke breedte.
const ratioClass = mobileRatio ? `${ratios[mobileRatio]} ${mdRatios[ratio]}` : ratios[ratio];

const toneName = backdrop.name.toLowerCase();

/**
 * Alt-teksten in het Nederlands, opgebouwd uit wat we van het beeld
 * weten: naam, soort en achtergrondkleur. Dat leest voor een schermlezer
 * als een beschrijving en voor Google als een dierenportret in een
 * studio — beide zonder dat er per foto een zin met de hand bij hoeft.
 */
const noun = subject ?? ANIMAL_NOUN[animal];
const altText =
  alt ??
  (name
    ? `Studioportret van ${name}, een ${noun}, op een ${backdrop.adjective} achtergrond`
    : `Studioportret van een ${noun} op een ${backdrop.adjective} achtergrond`);
---

<figure class={className} data-reveal="image" {...rest}>
  <div
    class={`relative overflow-hidden ${ratioClass} ${hover ? 'zoom-frame' : ''}`}
    style={`background-color:${backdrop.hex}`}
  >
    {
      typeof src === 'string' ? (
        <img
          src={src}
          alt={altText}
          loading={priority ? 'eager' : 'lazy'}
          decoding="async"
          style={`object-position:${objectPosition}`}
          class="zoom-target h-full w-full object-cover"
        />
      ) : src ? (
        <Image
          src={src}
          alt={altText}
          widths={WIDTHS}
          sizes={sizes}
          format="webp"
          quality={78}
          loading={priority ? 'eager' : 'lazy'}
          fetchpriority={priority ? 'high' : 'auto'}
          decoding="async"
          style={`object-position:${objectPosition}`}
          class="zoom-target h-full w-full object-cover"
        />
      ) : (
        <div class="zoom-target absolute inset-0">
          {/* Studiolicht dat op de achtergrond valt. */}
          <div
            class="absolute inset-0"
            style="background:radial-gradient(ellipse 70% 55% at 50% 32%, rgba(255,255,255,0.22), transparent 68%)"
          />
          <div
            class="absolute inset-0"
            style="background:radial-gradient(ellipse 90% 80% at 50% 45%, transparent 45%, rgba(0,0,0,0.28))"
          />
          <AnimalSilhouette
            animal={animal}
            class={`absolute left-1/2 w-auto max-w-none -translate-x-1/2 ${
              crop === 'tight' ? 'bottom-[-35%] h-[135%]' : 'bottom-0 h-[82%]'
            }`}
          />
          <span class="sr-only">{altText} — placeholder, fotografie volgt</span>
        </div>
      )
    }
  </div>

  {
    caption && name && (
      <figcaption class="mt-2.5 font-body text-[0.8rem] text-muted md:mt-3 md:text-sm">
        {name} — {toneName}
      </figcaption>
    )
  }
</figure>
