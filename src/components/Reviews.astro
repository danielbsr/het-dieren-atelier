---
import BookButton from './BookButton.astro';
import { REVIEWS } from '../data/site';

/**
 * Drie klantreacties, vijf sterren, geen widget.
 *
 * Een review-plugin dropt andermans typografie, kaarten en blauw midden
 * op de plek waar de site juist om vertrouwen vraagt. Dus zijn de quotes
 * gewoon inhoud, opgemaakt als de rest van de pagina.
 */
interface Props {
  /** De boekknop hoort onder het bewijs op Home, niet overal. */
  cta?: boolean;
}

const { cta = true } = Astro.props;
---

<div class="mx-auto max-w-[44rem] text-center">
  <p class="eyebrow" data-reveal="rise">Reviews</p>
  <h2 class="mt-5 text-section leading-[1.08] text-ink" data-reveal="line">
    Wat baasjes zeggen.
  </h2>
</div>

<div class="mt-12 grid gap-5 md:mt-16 md:grid-cols-3 md:gap-6">
  {
    REVIEWS.map((review) => (
      <blockquote
        data-reveal="rise"
        class="card-hover flex flex-col rounded-2xl border border-line bg-cream p-7 hover:border-forest/30 md:p-9"
      >
        <div class="flex gap-1 text-forest" aria-hidden="true">
          {Array.from({ length: review.rating }).map(() => (
            <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor">
              <path d="M8 .9l2.1 4.5 4.9.6-3.6 3.4.95 4.9L8 11.9 3.65 14.3l.95-4.9L1 6l4.9-.6z" />
            </svg>
          ))}
        </div>
        <span class="sr-only">{review.rating} van de 5 sterren</span>

        <p class="mt-6 flex-1 font-body text-[1rem] leading-relaxed text-ink/85">
          “{review.quote}”
        </p>

        <footer class="mt-7 font-body text-sm text-muted">
          <span class="block text-ink">{review.author}</span>
          <span class="block text-muted/80">{review.date}</span>
        </footer>
      </blockquote>
    ))
  }
</div>

{
  cta && (
    <div class="mt-12 text-center md:mt-14" data-reveal="rise">
      <BookButton block />
    </div>
  )
}
