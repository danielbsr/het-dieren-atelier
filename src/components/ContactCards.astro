---
import { STUDIO, supplied } from '../data/site';

/**
 * Three ways to reach a person, in the card language used for the
 * packages and the reviews.
 *
 * This replaced a contact form. A form asks someone to type their
 * details into a box and then wait without knowing whether it arrived;
 * a phone, a WhatsApp and a mail address hand them a channel they
 * already trust, and on a phone each card is one tap.
 *
 * Details that are still placeholders render as plain text rather than
 * dead links — see `supplied` in src/data/site.ts.
 */
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const digits = (value: string) => value.replace(/[^\d]/g, '');

const channels = [
  {
    id: 'whatsapp',
    label: 'WhatsApp',
    body: 'Quickest for a short question — and the easiest way to send us a photo of your animal.',
    value: STUDIO.whatsapp,
    href: supplied(STUDIO.whatsapp) ? `https://wa.me/${digits(STUDIO.whatsapp)}` : null,
    external: true,
  },
  {
    id: 'phone',
    label: 'Call us',
    body: 'Prefer to talk it through? A nervous animal is often a two-minute conversation.',
    value: STUDIO.phone,
    href: supplied(STUDIO.phone) ? `tel:${digits(STUDIO.phone)}` : null,
    external: false,
  },
  {
    id: 'email',
    label: 'Email',
    body: 'For longer questions, gift vouchers, and sessions at your home or on location.',
    value: STUDIO.email,
    href: supplied(STUDIO.email) ? `mailto:${STUDIO.email}` : null,
    external: false,
  },
];

const card =
  'card-hover flex h-full flex-col rounded-2xl border bg-cream p-7 md:p-8';
---

<div class={`grid gap-5 md:grid-cols-3 md:gap-6 ${className}`}>
  {
    channels.map((channel) => {
      const inner = (
        <>
          <span class="flex h-11 w-11 items-center justify-center rounded-full bg-forest/[0.07] text-forest">
            {channel.id === 'whatsapp' && (
              /*
                The official WhatsApp mark, as one filled path. A hand-rolled
                outline version fills solid: the ring's outer and inner arcs
                wind the same way, so non-zero fill sees one shape, not a ring.
                Drawn a few pixels smaller than the two stroked icons beside
                it, so a solid glyph and a 1.6px outline carry the same weight.
              */
              <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z" />
              </svg>
            )}
            {channel.id === 'phone' && (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path
                  d="M6.3 3.5h3l1.5 3.8-1.9 1.2a11.5 11.5 0 0 0 5.6 5.6l1.2-1.9 3.8 1.5v3a2 2 0 0 1-2.2 2A16.8 16.8 0 0 1 4.3 5.7a2 2 0 0 1 2-2.2Z"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linejoin="round"
                />
              </svg>
            )}
            {channel.id === 'email' && (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <rect
                  x="2.9"
                  y="5"
                  width="18.2"
                  height="14"
                  rx="2.4"
                  stroke="currentColor"
                  stroke-width="1.6"
                />
                <path
                  d="m3.6 7 7.3 5.3c.65.48 1.55.48 2.2 0L20.4 7"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                />
              </svg>
            )}
          </span>

          <h3 class="mt-6 font-display text-xl text-ink">{channel.label}</h3>
          <p class="mt-3 flex-1 font-body text-[0.95rem] leading-relaxed text-muted">
            {channel.body}
          </p>

          {channel.href ? (
            <span class="mt-6 inline-flex items-center gap-2 font-body font-medium text-forest underline-offset-4 group-hover:underline">
              {channel.value}
              <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">
                →
              </span>
            </span>
          ) : (
            <span class="mt-6 block font-body text-[0.95rem] text-ink/40">{channel.value}</span>
          )}
        </>
      );

      return channel.href ? (
        <a
          data-reveal="rise"
          href={channel.href}
          target={channel.external ? '_blank' : undefined}
          rel={channel.external ? 'noopener noreferrer' : undefined}
          class={`group ${card} border-line hover:border-forest/30`}
        >
          {inner}
        </a>
      ) : (
        <div data-reveal="rise" class={`${card} border-dashed border-line`}>
          {inner}
        </div>
      );
    })
  }
</div>
