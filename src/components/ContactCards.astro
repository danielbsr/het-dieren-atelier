---
import WhatsAppIcon from './WhatsAppIcon.astro';
import { EMAIL_URL, PHONE_URL, STUDIO, WHATSAPP_URL } from '../data/site';

/**
 * Drie manieren om een mens te bereiken, in dezelfde kaarttaal als de
 * pakketten en de reviews.
 *
 * Dit verving een contactformulier. Een formulier vraagt iemand om zijn
 * gegevens in een vakje te typen en dan te wachten zonder te weten of
 * het aankwam; een telefoon, een WhatsApp en een mailadres geven een
 * kanaal dat ze al vertrouwen — en op een telefoon is elke kaart één tik.
 */
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const channels = [
  {
    id: 'whatsapp',
    label: 'WhatsApp',
    body: 'Het snelst voor een korte vraag — en de makkelijkste manier om ons een foto van jouw dier te sturen.',
    value: STUDIO.whatsapp,
    href: WHATSAPP_URL,
    external: true,
  },
  {
    id: 'phone',
    label: 'Bel ons',
    body: 'Liever even overleggen? Een onzeker dier is vaak een gesprek van twee minuten.',
    value: STUDIO.phone,
    href: PHONE_URL,
    external: false,
  },
  {
    id: 'email',
    label: 'E-mail',
    body: 'Voor langere vragen, cadeaubonnen en een fotoshoot bij jou op locatie.',
    value: STUDIO.email,
    href: EMAIL_URL,
    external: false,
  },
];

const card =
  'card-hover group flex h-full flex-col rounded-2xl border border-line bg-cream p-7 hover:border-forest/30 md:p-8';
---

<div class={`grid gap-5 md:grid-cols-3 md:gap-6 ${className}`}>
  {
    channels.map((channel) => (
      <a
        data-reveal="rise"
        href={channel.href}
        target={channel.external ? '_blank' : undefined}
        rel={channel.external ? 'noopener noreferrer' : undefined}
        class={card}
      >
        <span class="flex h-11 w-11 items-center justify-center rounded-full bg-forest/[0.07] text-forest">
          {channel.id === 'whatsapp' && <WhatsAppIcon size={17} />}
          {channel.id === 'phone' && (
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M6.3 3.5h3l1.5 3.8-1.9 1.2a11.5 11.5 0 0 0 5.6 5.6l1.2-1.9 3.8 1.5v3a2 2 0 0 1-2.2 2A16.8 16.8 0 0 1 4.3 5.7a2 2 0 0 1 2-2.2Z"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linejoin="round"
              />
            </svg>
          )}
          {channel.id === 'email' && (
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect
                x="2.9"
                y="5"
                width="18.2"
                height="14"
                rx="2.4"
                stroke="currentColor"
                stroke-width="1.6"
              />
              <path
                d="m3.6 7 7.3 5.3c.65.48 1.55.48 2.2 0L20.4 7"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
              />
            </svg>
          )}
        </span>

        <h3 class="mt-6 font-display text-xl text-ink">{channel.label}</h3>
        <p class="mt-3 flex-1 font-body text-[0.95rem] leading-relaxed text-muted">
          {channel.body}
        </p>

        <span class="mt-6 inline-flex items-center gap-2 font-body font-medium text-forest underline-offset-4 group-hover:underline">
          {channel.value}
          <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">
            →
          </span>
        </span>
      </a>
    ))
  }
</div>
