---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { CTA, withBase } from '../data/site';

interface Props {
  title: string;
  description?: string;
  /** The booking page already is the CTA — no need to float it there. */
  showMobileCta?: boolean;
}

const { title, description = '', showMobileCta = true } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="icon" href={withBase('/favicon.ico')} />
    <meta name="generator" content={Astro.generator} />

    <!--
      REMOVE BEFORE LAUNCH. This deploy exists to show people the work in
      progress, not to be found — the studio has no address, phone or
      opening date yet. Delete this line the day the real site goes live.
    -->
    <meta name="robots" content="noindex, nofollow" />

    <!--
      Marks the document as script-capable before first paint. Reveal
      styles hang off html.js, so if this never runs the page renders
      fully visible instead of blank.
    -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class={showMobileCta ? 'pb-[4.75rem] md:pb-0' : ''}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded-full focus:bg-forest focus:px-5 focus:py-3 focus:text-cream"
    >
      Skip to content
    </a>

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />

    {
      showMobileCta && (
        <div class="fixed inset-x-0 bottom-0 z-50 border-t border-forest-deep/20 bg-cream/95 p-3 backdrop-blur-md md:hidden">
          <a
            href={CTA.book.href}
            class="flex w-full items-center justify-center rounded-full bg-forest px-6 py-3.5 font-body font-medium text-cream"
          >
            {CTA.book.label}
          </a>
        </div>
      )
    }

    <script>
      /*
        Scroll reveals.

        Elements opt in with data-reveal="rise|line|image". Anything that
        crosses the viewport in the same batch is staggered automatically,
        so grids cascade without any per-element delay in the markup.
        The stagger is capped: an element deep in a long grid should not
        wait a second after it is already on screen.
      */
      const STEP = 90;
      const MAX_STEPS = 6;
      const BATCH_MS = 250;

      const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');

      let inBatch = 0;
      let lastReveal = 0;

      const observer = new IntersectionObserver(
        (entries) => {
          const now = performance.now();
          if (now - lastReveal > BATCH_MS) inBatch = 0;

          const arriving = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) =>
              a.target.compareDocumentPosition(b.target) & Node.DOCUMENT_POSITION_FOLLOWING
                ? -1
                : 1
            );

          for (const entry of arriving) {
            const el = entry.target as HTMLElement;
            el.style.setProperty('--reveal-delay', `${Math.min(inBatch, MAX_STEPS) * STEP}ms`);
            el.classList.add('is-revealed');
            observer.unobserve(el);
            inBatch++;
            lastReveal = now;
          }
        },
        { rootMargin: '0px 0px -10% 0px', threshold: 0.08 }
      );

      for (const target of targets) observer.observe(target);
    </script>
  </body>
</html>
