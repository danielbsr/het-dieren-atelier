---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Portrait from '../components/Portrait.astro';
import ClosingCta from '../components/ClosingCta.astro';
import BookButton from '../components/BookButton.astro';
import { PORTFOLIO, PORTFOLIO_FILTERS } from '../data/site';
import { photo } from '../data/photos';

/** An inline CTA band interrupts the grid every nine portraits. */
const CHUNK = 9;
const chunks = Array.from({ length: Math.ceil(PORTFOLIO.length / CHUNK) }, (_, i) =>
  PORTFOLIO.slice(i * CHUNK, i * CHUNK + CHUNK)
);

/**
 * Varied crops so the grid reads as a wall, not a contact sheet — at
 * md and up. Two phone-width columns of different heights just look
 * misaligned, so below md every tile is the same 4:5.
 */
const shapes = ['tall', 'portrait', 'portrait', 'portrait', 'tall', 'square'] as const;
---

<Layout
  title="Portfolio — dog, cat, bird & rabbit portraits"
  description="Recent studio portraits: dogs, cats, birds, rabbits and other pets on hand-picked backdrops. See the work before you book."
>
  <PageHeader
    eyebrow="Portfolio"
    title="The portfolio."
    intro="A selection of recent sessions — dogs and cats, but just as often a rabbit, a bird or something that surprises us. Every portrait was made with time and patience."
  />

  <!-- Filters -->
  <div class="pb-8 pt-8 md:pb-14 md:pt-14">
    <div class="mx-auto max-w-[75rem] md:px-10">
      <!--
        The padding and the negative margins that cancel it: a scroller
        clips on both axes, and a focused pill wears a 2px outline 3px
        clear of its edge. Without the room that outline is shaved off
        against the row. The margins keep the spacing unchanged.
      -->
      <div
        class="-mb-4 -mt-2 flex gap-2 overflow-x-auto px-6 pb-4 pt-2 md:mb-0 md:mt-0 md:flex-wrap md:overflow-visible md:px-0 md:pb-0 md:pt-0"
        role="group"
        aria-label="Filter portraits by animal"
        data-reveal="rise"
      >
        {
          PORTFOLIO_FILTERS.map((filter, i) => (
            <button
              type="button"
              data-filter={filter.id}
              aria-pressed={i === 0 ? 'true' : 'false'}
              class="btn btn-outline shrink-0 whitespace-nowrap rounded-full border border-forest/20 px-5 py-2 font-body text-sm text-forest aria-[pressed=true]:border-forest aria-[pressed=true]:bg-forest aria-[pressed=true]:text-cream"
            >
              {filter.label}
            </button>
          ))
        }
      </div>
    </div>
  </div>

  {
    chunks.map((chunk, chunkIndex) => (
      <>
        <div class="mx-auto max-w-[75rem] px-6 md:px-10">
          <div class="grid grid-cols-2 gap-4 md:grid-cols-3 md:gap-7">
            {chunk.map((item, i) => (
              <Portrait
                data-species={item.species}
                tone={item.tone}
                name={item.name}
                animal={item.animal}
                src={item.src ?? photo(item.photo)}
                sizes="(min-width: 1200px) 360px, (min-width: 768px) 32vw, 50vw"
                ratio={shapes[(chunkIndex * CHUNK + i) % shapes.length]}
                mobileRatio="portrait"
                crop={i % 4 === 0 ? 'tight' : 'full'}
                caption
                hover
                class="portfolio-item"
              />
            ))}
          </div>
        </div>

        {chunkIndex < chunks.length - 1 && (
          <div class="mx-auto max-w-[75rem] px-6 py-14 md:px-10 md:py-24">
            <div
              class="flex flex-col items-stretch gap-6 rounded-2xl border border-line px-6 py-10 text-center md:flex-row md:items-center md:justify-between md:px-8 md:py-12 md:text-left"
              data-reveal="rise"
            >
              <p class="font-display text-2xl text-ink md:text-3xl">
                Imagining your own animal here?
              </p>
              <div class="shrink-0">
                <BookButton block size="md" />
              </div>
            </div>
          </div>
        )}
      </>
    ))
  }

  <!-- Nothing matched the active filter. -->
  <div class="mx-auto max-w-[75rem] px-6 md:px-10">
    <p id="portfolio-empty" hidden class="py-14 text-center font-body text-muted">
      No portraits in this category yet.
    </p>
  </div>

  <!-- Repeat the booking button under the full grid, before the closing block. -->
  <div class="mx-auto max-w-[75rem] px-6 py-14 text-center md:px-10 md:py-24" data-reveal="rise">
    <BookButton block class="mx-auto max-w-sm" />
  </div>

  <ClosingCta
    headline="Your animal. On your wall."
    body="Pick a date in the calendar — the rest happens calmly, in the studio or at your home."
    tone="pearl"
    photo="mila"
  />
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const items = document.querySelectorAll<HTMLElement>('.portfolio-item');
  const empty = document.getElementById('portfolio-empty');

  for (const button of buttons) {
    button.addEventListener('click', () => {
      const active = button.dataset.filter;
      let shown = 0;

      for (const other of buttons) {
        other.setAttribute('aria-pressed', String(other === button));
      }

      for (const item of items) {
        const match = active === 'all' || item.dataset.species === active;
        item.hidden = !match;
        if (match) shown++;
      }

      if (empty) empty.hidden = shown > 0;
    });
  }
</script>
