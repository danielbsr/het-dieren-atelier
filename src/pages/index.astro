---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import Portrait from '../components/Portrait.astro';
import Interior from '../components/Interior.astro';
import Usps from '../components/Usps.astro';
import PackageCards from '../components/PackageCards.astro';
import Faq from '../components/Faq.astro';
import ClosingCta from '../components/ClosingCta.astro';
import Reviews from '../components/Reviews.astro';
import BookButton from '../components/BookButton.astro';
import { photo } from '../data/photos';
import {
  BACKDROPS,
  COLOUR_STRIP,
  CTA,
  FAQ_SHORT,
  HOME_SELECTION,
  PACKAGE_NOTE,
  STEPS,
} from '../data/site';

/**
 * Gecureerde wand: twee grote portretten, vier kleinere, ongelijk — zodat
 * het grid leest als een selectie en niet als een database-dump.
 *
 * Op een telefoon vervalt de ongelijkheid. Twee kolommen met
 * verschillende hoogtes lezen daar als een kapot grid, niet als curatie,
 * dus wordt elke tegel dezelfde 4:5 en komt de afwisseling van de dieren.
 */
const layout = [
  { span: 'md:col-span-5', ratio: 'tall' as const },
  { span: 'md:col-span-4 md:self-end', ratio: 'portrait' as const },
  { span: 'md:col-span-3 md:self-end', ratio: 'square' as const },
  { span: 'md:col-span-4', ratio: 'portrait' as const },
  { span: 'md:col-span-5', ratio: 'tall' as const },
  { span: 'md:col-span-3 md:self-end', ratio: 'square' as const },
];
---

<Layout
  title="Dierenfotograaf in Blokker bij Hoorn"
  description="Professionele dierenfotoshoot in onze studio in Blokker bij Hoorn. Van portret tot persoonlijk kunstwerk voor aan de muur. Max. 45 minuten, vanaf €249."
>
  <!-- ============================================================= Hero -->
  <section class="border-b border-line">
    <div
      class="mx-auto grid max-w-[75rem] items-center gap-8 px-6 pb-14 pt-8 md:min-h-[82vh] md:grid-cols-2 md:gap-16 md:px-10 md:pb-24 md:pt-16 lg:gap-24"
    >
      <div>
        <p class="eyebrow" data-reveal="rise">
          Dierenfotografie in Blokker, naast Hoorn
        </p>

        <h1 class="mt-5 text-hero leading-[1] text-ink md:mt-7 md:leading-[0.98]" data-reveal="line">
          Jouw dier. Als kunstwerk.
        </h1>

        <p
          class="mt-6 max-w-[34rem] font-body text-[1.0625rem] leading-relaxed text-muted md:mt-8 md:text-xl"
          data-reveal="rise"
        >
          Een professionele fotoshoot waarin we het karakter van jouw huisdier vastleggen. Van
          portret tot persoonlijk kunstwerk voor aan de muur.
        </p>

        <div
          class="mt-8 flex flex-col items-stretch gap-5 sm:flex-row sm:items-center sm:gap-8 md:mt-11"
          data-reveal="rise"
        >
          <BookButton block />
          <a
            href={CTA.portfolio.href}
            class="group inline-flex items-center justify-center gap-2 font-body text-forest underline-offset-4 hover:underline sm:justify-start"
          >
            {CTA.portfolio.label}
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
          </a>
        </div>
      </div>

      <!--
        Eén stil, zelfverzekerd beeld. Het zet de kwaliteitslat voor de
        hele site.

        Op een telefoon volgt het de woorden in plaats van ze voor te
        gaan: een foto van een hond zegt niets over wat er verkocht
        wordt, en vooropgaan duwde de boekknop van het eerste scherm af.

        De verhouding is overal 4:5 — precies de verhouding van het
        bronbestand. Daardoor wordt er nergens iets weggesneden en kan de
        kop van het dier op geen enkel scherm half wegvallen (punt 8).
      -->
      <div>
        <Portrait
          tone="charcoal"
          animal="dog"
          subject="golden retriever"
          src={photo('hero')}
          ratio="portrait"
          priority
          sizes="(min-width: 768px) 480px, 100vw"
          alt="Studioportret van een golden retriever op een antracietkleurige achtergrond"
          class="md:ml-auto md:max-w-[30rem]"
        />
      </div>
    </div>
  </section>

  <!-- ============================================================= USP's -->
  <Section space="tight">
    <Usps />
  </Section>

  <!-- ========================================================== Concept -->
  <Section width="text" space="normal" class="text-center">
    <h2 class="text-section leading-[1.08] text-ink" data-reveal="line">
      Een fotoshoot die om jouw dier heen is gebouwd.
    </h2>
    <div class="prose-calm mt-8" data-reveal="rise">
      <p>
        Het Dieren Atelier is een dierenfotostudio voor honden, katten en andere huisdieren. We
        werken rustig, met pauzes, snacks en tijd om te wennen. Het resultaat is geen map vol
        kiekjes, maar één tot drie professioneel bewerkte portretten: het karakter van jouw dier,
        voor één keer stilgezet — en klaar om aan de muur te hangen.
      </p>
    </div>
    <a
      href={CTA.process.href}
      class="group mt-9 inline-flex items-center gap-2 font-body text-forest underline-offset-4 hover:underline"
      data-reveal="rise"
    >
      {CTA.process.label}
      <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
    </a>
  </Section>

  <!-- ============================================== Portfolio-selectie -->
  <Section space="normal">
    <h2 class="text-section text-ink" data-reveal="line">Recent werk.</h2>
    <p class="mt-4 max-w-[36rem] font-body text-muted md:text-lg" data-reveal="rise">
      Honden, katten, vogels en konijnen — de dieren zijn het hele punt.
    </p>

    <div class="mt-10 grid grid-cols-2 gap-4 md:mt-16 md:grid-cols-12 md:gap-6">
      {
        HOME_SELECTION.map((item, i) => (
          <Portrait
            tone={item.tone}
            name={item.name}
            animal={item.animal}
            subject={item.subject}
            src={photo(item.photo)}
            sizes="(min-width: 1200px) 460px, (min-width: 768px) 40vw, 50vw"
            ratio={layout[i].ratio}
            mobileRatio="portrait"
            caption
            hover
            class={layout[i].span}
          />
        ))
      }
    </div>

    <!--
      Niet iedereen is na de hero al klaar om €249–€549 te boeken. Na het
      werk en het concept komt daarom eerst de stap ernaartoe — tarieven
      bekijken — en pas verderop weer de boekknop (punt 2 van de
      aanvullende feedback).
    -->
    <div
      class="mt-12 flex flex-col items-stretch gap-4 sm:flex-row sm:items-center sm:justify-center sm:gap-6 md:mt-14"
      data-reveal="rise"
    >
      <a
        href={CTA.packages.href}
        class="btn btn-solid inline-flex items-center justify-center rounded-full bg-forest px-9 py-4 font-body font-medium text-cream"
      >
        {CTA.packages.label}
      </a>
      <a
        href={CTA.portfolio.href}
        class="btn btn-outline inline-flex items-center justify-center rounded-full border border-forest/25 px-9 py-4 font-body font-medium text-forest"
      >
        {CTA.portfolio.label}
      </a>
    </div>
  </Section>

  <!-- =================================================== Wanddecoratie -->
  <!--
    De sectie die de hele propositie moet dragen: dit is geen fotoshoot,
    het is een stuk voor aan jouw muur. Daarom echte interieurfoto's,
    groot — niet een nagebouwde kamer (punt 13).
  -->
  <Section space="loose">
    <div class="max-w-[46rem]">
      <p class="eyebrow" data-reveal="rise">Wanddecoratie</p>
      <h2 class="mt-5 text-section leading-[1.08] text-ink" data-reveal="line">
        Een portret hoort aan een muur, niet in een telefoon.
      </h2>
      <p
        class="mt-6 font-body text-[1.0625rem] leading-relaxed text-muted md:mt-7 md:text-lg"
        data-reveal="rise"
      >
        Na de fotoshoot kiezen we samen het formaat en het materiaal dat bij jouw huis past: Fine
        Art, aluminium of plexiglas. In de studio, met echte voorbeelden in je handen en op ware
        grootte. Je beslist rustig, nadat je jouw foto's hebt gezien.
      </p>
    </div>

    <Interior
      photo="interieur-breed"
      alt="Groot portret van een zwarte labrador aan de muur van een lichte woonkamer met bank en salontafel"
      ratio="wide"
      sizes="(min-width: 1200px) 1120px, 100vw"
      class="mt-12 md:mt-16"
    />

    <div class="mt-5 grid gap-5 md:mt-6 md:grid-cols-3 md:gap-6">
      <Interior
        photo="fineart-ingelijst"
        alt="Ingelijste Fine Art-print van een zwarte dog boven een eiken dressoir"
        label="Fine Art"
      />
      <Interior
        photo="aluminium"
        alt="Aluminium portret van een border collie op een blauwe achtergrond in een woonkamer"
        label="Aluminium"
      />
      <Interior
        photo="plexiglas"
        alt="Plexiglas portret van een ragdollkat boven een houten dressoir"
        label="Plexiglas"
      />
    </div>

    <p class="mt-8 font-body text-sm text-muted md:mt-10" data-reveal="rise">
      De pakketten Signature en Collection bevatten €50 of €100 tegoed voor wanddecoratie.
    </p>

    <div class="mt-8" data-reveal="rise">
      <a
        href={CTA.wallArt.href}
        class="btn btn-outline inline-flex items-center justify-center rounded-full border border-forest/25 px-9 py-4 font-body font-medium text-forest"
      >
        {CTA.wallArt.label}
      </a>
    </div>
  </Section>

  <!-- ==================================================== Achtergronden -->
  <Section space="loose">
    <div class="max-w-[44rem]">
      <h2 class="text-section leading-[1.08] text-ink" data-reveal="line">
        Elke fotoshoot begint met een kleur.
      </h2>
      <p
        class="mt-6 font-body text-[1.0625rem] leading-relaxed text-muted md:mt-7 md:text-lg"
        data-reveal="rise"
      >
        Ieder portret wordt gemaakt op een met de hand gekozen achtergrond — van zacht parel tot
        diep antraciet. Samen kiezen we de tinten die passen bij de vacht, de ogen en het karakter
        van jouw dier.
      </p>
    </div>

    <div class="-mx-6 mt-12 overflow-x-auto px-6 pb-2 md:mx-0 md:mt-16 md:overflow-visible md:px-0">
      <ul class="flex min-w-max gap-3 md:grid md:min-w-0 md:grid-cols-7 md:gap-4">
        {
          COLOUR_STRIP.map(({ tone, photo: slot }) => (
            <li class="w-32 sm:w-36 md:w-auto">
              <Portrait
                tone={tone}
                src={photo(slot)}
                sizes="(min-width: 768px) 150px, 144px"
                ratio="portrait"
                hover
                alt={`Studioportret op een ${BACKDROPS[tone].adjective} achtergrond`}
              />
              <div class="mt-3 flex items-center gap-2">
                <span
                  class="h-2.5 w-2.5 shrink-0 rounded-full ring-1 ring-inset ring-black/10"
                  style={`background-color:${BACKDROPS[tone].hex}`}
                  aria-hidden="true"
                />
                <span class="font-body text-[0.8rem] text-muted md:text-sm">
                  {BACKDROPS[tone].name}
                </span>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <p class="mt-8 font-body text-sm text-muted" data-reveal="rise">
      Welke achtergronden beschikbaar zijn kan per datum verschillen.
    </p>
  </Section>

  <!-- ======================================================= Pakketten -->
  <Section space="normal">
    <div class="mx-auto max-w-[40rem] text-center">
      <h2 class="text-section leading-[1.08] text-ink" data-reveal="line">
        Vier manieren om te boeken.
      </h2>
      <p class="mt-5 font-body text-muted md:text-lg" data-reveal="rise">
        Drie fotoshoots in de studio — of we komen met de mobiele studio naar jou toe.
      </p>
    </div>

    <PackageCards class="mt-12 md:mt-16" cta={false} />

    <p
      class="mx-auto mt-12 max-w-[46rem] text-center font-body text-[1rem] leading-relaxed text-muted md:mt-14 md:text-[1.05rem]"
      data-reveal="rise"
    >
      {PACKAGE_NOTE}
    </p>

    <div
      class="mt-8 flex flex-col items-stretch gap-5 sm:flex-row sm:items-center sm:justify-center sm:gap-8 md:mt-10"
      data-reveal="rise"
    >
      <BookButton block />
      <a
        href={CTA.packages.href}
        class="group inline-flex items-center justify-center gap-2 font-body text-forest underline-offset-4 hover:underline"
      >
        Bekijk alle tarieven
        <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
      </a>
    </div>
  </Section>

  <!-- ======================================================= Werkwijze -->
  <Section space="normal">
    <h2 class="max-w-[24ch] text-section leading-[1.08] text-ink" data-reveal="line">
      Rustig, vanaf de eerste minuut.
    </h2>

    <ol
      class="mt-10 grid gap-px overflow-hidden rounded-2xl border border-line bg-line md:mt-16 md:grid-cols-5"
    >
      {
        STEPS.map((step) => (
          <li class="bg-cream p-7 md:p-6 lg:p-7" data-reveal="rise">
            <span class="block font-display text-[2.25rem] leading-none text-forest/25 md:text-[2.5rem]">
              {step.number}
            </span>
            <h3 class="mt-5 font-display text-lg leading-snug text-ink md:mt-6 md:text-xl">
              {step.title}
            </h3>
            <p class="mt-3 font-body text-[0.9rem] leading-relaxed text-muted">{step.short}</p>
          </li>
        ))
      }
    </ol>

    <p
      class="mx-auto mt-12 max-w-[44rem] text-center font-body text-[1.0625rem] italic leading-relaxed text-ink/80 md:mt-14 md:text-lg"
      data-reveal="rise"
    >
      Geen dier hoeft hier te presteren. Drukke honden en schuwe katten zijn ons dagelijks werk —
      de fotoshoot past zich aan hen aan, nooit andersom.
    </p>

    <div class="mt-8 text-center" data-reveal="rise">
      <a
        href={CTA.process.href}
        class="group inline-flex items-center gap-2 font-body text-forest underline-offset-4 hover:underline"
      >
        {CTA.process.label}
        <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
      </a>
    </div>
  </Section>

  <!-- ========================================================= Reviews -->
  <Section space="normal">
    <Reviews />
  </Section>

  <!-- ======================================================= Korte FAQ -->
  <Section space="normal">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,20rem)_1fr] lg:gap-20">
      <div>
        <h2 class="text-section text-ink" data-reveal="line">Goed om te weten.</h2>
        <a
          href={`${CTA.process.href}#veelgestelde-vragen`}
          class="group mt-6 inline-flex items-center gap-2 font-body text-forest underline-offset-4 hover:underline lg:mt-8"
          data-reveal="rise"
        >
          Alle veelgestelde vragen
          <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
        </a>
      </div>

      <Faq items={FAQ_SHORT} />
    </div>
  </Section>

  <!-- ===================================================== Afsluitende CTA -->
  <ClosingCta
    headline="Jouw dier. Aan jouw muur."
    body="Kies een datum in de agenda — de rest gebeurt rustig, in de studio of bij jou op locatie."
    tone="charcoal"
    photo="joep"
    animal="dog"
    subject="herdershond"
  />
</Layout>
