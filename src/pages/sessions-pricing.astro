---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import PackageCards from '../components/PackageCards.astro';
import Portrait from '../components/Portrait.astro';
import Faq from '../components/Faq.astro';
import ClosingCta from '../components/ClosingCta.astro';
import BookButton from '../components/BookButton.astro';
import { photo } from '../data/photos';
import { ADD_ONS, COMPARISON, FAQ_BOOKING, ON_LOCATION, PACKAGES, PACKAGE_NOTE } from '../data/site';
---

<Layout
  title="Sessions & pricing — packages from €249"
  description="Three clear packages: Essential €249, Signature €379, Collection €549. Session length, edited photos and backdrops compared."
>
  <PageHeader
    eyebrow="Sessions & pricing"
    title="Sessions & pricing."
    intro="Three studio packages, one difference between them: time and variety. And a fourth option, where the studio comes to your home instead."
  />

  <!-- Packages -->
  <Section space="normal">
    <PackageCards cta={false} />
    <p
      class="mx-auto mt-12 max-w-[46rem] text-center font-body text-[1rem] leading-relaxed text-muted md:mt-14 md:text-[1.05rem]"
      data-reveal="rise"
    >
      {PACKAGE_NOTE}
    </p>
    <div class="mt-9 text-center md:mt-10" data-reveal="rise">
      <BookButton block class="mx-auto max-w-sm" />
    </div>
  </Section>

  <!-- Full comparison -->
  <Section space="normal">
    <h2 class="text-section text-ink" data-reveal="line">Compared, line by line.</h2>
    <p class="mt-4 font-body text-sm text-muted md:hidden" data-reveal="rise">
      Swipe the table sideways to see all three.
    </p>

    <div class="-mx-6 mt-8 overflow-x-auto px-6 md:mx-0 md:mt-16 md:px-0" data-reveal="rise">
      <table class="w-full min-w-[42rem] border-collapse text-left">
        <caption class="sr-only">Comparison of the Essential, Signature and Collection packages</caption>
        <thead>
          <tr class="border-b border-forest/25">
            <th scope="col" class="py-5 pr-6 font-body text-sm font-medium text-muted">
              <span class="sr-only">Feature</span>
            </th>
            {
              PACKAGES.map((pkg) => (
                <th scope="col" class="py-5 pr-6 align-bottom">
                  <span class="block font-display text-xl text-ink">{pkg.name}</span>
                  {pkg.featured && (
                    <span class="mt-2 inline-block rounded-full bg-lime px-3 py-0.5 font-body text-[0.65rem] font-medium uppercase tracking-[0.14em] text-forest-deep">
                      Most chosen
                    </span>
                  )}
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            COMPARISON.map((row) => (
              <tr class="border-b border-line">
                <th scope="row" class="py-5 pr-6 font-body text-[0.95rem] font-normal text-muted">
                  {row.label}
                </th>
                {row.values.map((value, i) => (
                  <td
                    class={`py-5 pr-6 font-body text-[0.95rem] ${
                      i === 1 ? 'text-ink' : 'text-ink/80'
                    }`}
                  >
                    {value}
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p class="mt-8 max-w-[46rem] font-body text-[0.95rem] leading-relaxed text-muted" data-reveal="rise">
      The on-location session sits outside this table: approx. 90 minutes at your home, 10 edited
      photos, and your own interior — or a portable backdrop — as the setting.
    </p>
  </Section>

  <!-- What "more backdrops" actually buys -->
  <Section space="tight">
    <div class="grid grid-cols-3 gap-3 md:gap-6">
      <Portrait
        tone="sage"
        src={photo('noor')}
        sizes="(min-width: 768px) 355px, 33vw"
        ratio="square"
        crop="tight"
        hover
      />
      <Portrait
        tone="caramel"
        src={photo('knabbel')}
        sizes="(min-width: 768px) 355px, 33vw"
        ratio="square"
        crop="tight"
        hover
      />
      <Portrait
        tone="midnight"
        src={photo('storm')}
        sizes="(min-width: 768px) 355px, 33vw"
        ratio="square"
        crop="tight"
        hover
      />
    </div>
    <p class="mt-5 font-body text-sm text-muted" data-reveal="rise">
      The backdrop is chosen for the animal — coat, eyes, character. Larger packages give you
      two or three of them in one session.
    </p>
  </Section>

  <!-- Add-ons -->
  <Section space="normal">
    <h2 class="text-section text-ink" data-reveal="line">Add-ons.</h2>
    <div class="mt-12 grid gap-6 md:mt-14 md:grid-cols-2">
      {
        ADD_ONS.map((addOn) => (
          <div class="rounded-2xl border border-line p-8" data-reveal="rise">
            <div class="flex items-baseline justify-between gap-4">
              <h3 class="font-display text-xl text-ink">{addOn.title}</h3>
              <span class="shrink-0 font-display text-xl text-forest">{addOn.price}</span>
            </div>
            <p class="mt-3 font-body text-[0.95rem] leading-relaxed text-muted">{addOn.body}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- Which package fits? -->
  <Section space="normal">
    <h2 class="text-section text-ink" data-reveal="line">Which package fits?</h2>
    <dl class="mt-12 space-y-10 md:mt-14">
      {
        PACKAGES.map((pkg) => (
          <div class="grid gap-3 border-t border-line pt-8 md:grid-cols-[10rem_1fr] md:gap-10" data-reveal="rise">
            <dt class="font-display text-xl text-forest">{pkg.name}</dt>
            <dd class="max-w-[44rem] font-body text-[1.05rem] leading-relaxed text-muted">
              {pkg.guidance}
            </dd>
          </div>
        ))
      }

      <div class="grid gap-3 border-t border-line pt-8 md:grid-cols-[10rem_1fr] md:gap-10" data-reveal="rise">
        <dt class="font-display text-xl text-forest">{ON_LOCATION.name}</dt>
        <dd class="max-w-[44rem] font-body text-[1.05rem] leading-relaxed text-muted">
          {ON_LOCATION.guidance}
        </dd>
      </div>
    </dl>

    <div class="mt-12 text-center md:mt-14" data-reveal="rise">
      <BookButton block class="mx-auto max-w-sm" />
    </div>
  </Section>

  <!-- Booking questions -->
  <Section space="normal">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,20rem)_1fr] lg:gap-20">
      <h2 class="text-section text-ink" data-reveal="line">Before you book.</h2>
      <Faq items={FAQ_BOOKING} />
    </div>
  </Section>

  <ClosingCta
    headline="Pick your package."
    body="Pick a date in the calendar — the rest happens calmly, in the studio or at your home."
    tone="taupe"
    photo="daan"
  />
</Layout>
