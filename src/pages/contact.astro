---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import MapEmbed from '../components/MapEmbed.astro';
import Portrait from '../components/Portrait.astro';
import BookButton from '../components/BookButton.astro';
import ContactCards from '../components/ContactCards.astro';
import { photo } from '../data/photos';
import { BOOKING_URL, CTA, STUDIO } from '../data/site';

/**
 * Booking is Calendly's job now.
 *
 * This page used to carry a hand-built availability calendar filled with
 * invented free days and a form that posted nowhere. Both are gone: a
 * calendar that cannot be trusted is worse than no calendar, and two
 * booking routes — one real, one decorative — is the fastest way to lose
 * a booking. What is left is the real calendar, and the ways to reach a
 * person before using it.
 *
 * Branded to the site palette through Calendly's embed parameters, so
 * the widget does not arrive in somebody else's blue.
 */
const calendlyEmbed = `${BOOKING_URL}?hide_gdpr_banner=1&background_color=f6f4ec&text_color=1f1c17&primary_color=1d3b2e`;
---

<Layout
  title="Book your session — Het Dieren Atelier"
  description="Pick your date in the calendar and book your pet's studio session in Blokker — or ask a question first. Studio and on-location sessions."
  showMobileCta={false}
  showFooterCta
>
  <Section space="tight">
    <div class="grid items-center gap-8 md:grid-cols-[1fr_auto] md:gap-16">
      <div>
        <p class="eyebrow" data-reveal="rise">Contact &amp; booking</p>
        <h1 class="mt-5 max-w-[16ch] text-page leading-[1.03] text-ink" data-reveal="line">
          Book your session.
        </h1>
        <p
          class="mt-6 max-w-[38rem] font-body text-[1.0625rem] leading-relaxed text-muted md:mt-7 md:text-lg"
          data-reveal="rise"
        >
          Pick a date and time in the calendar below — you'll receive a confirmation and a short
          preparation guide. Not sure which package yet? Choose the date first; we settle the rest
          together before the session.
        </p>

        <a
          href={CTA.packages.href}
          class="group mt-7 inline-flex items-center gap-2 font-body text-forest underline-offset-4 hover:underline"
          data-reveal="rise"
        >
          {CTA.packages.label}
          <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
        </a>
      </div>

      <!-- Hidden on a phone: the calendar is what this page is for, and a
           decorative square only pushes it further down the screen. -->
      <Portrait
        tone="pearl"
        src={photo('mila')}
        sizes="192px"
        ratio="square"
        crop="tight"
        class="hidden w-48 md:block"
      />
    </div>
  </Section>

  <!-- ================================================== The real calendar -->
  <Section space="tight">
    <div
      class="overflow-hidden rounded-2xl border border-line bg-cream"
      data-reveal="rise"
    >
      <div
        class="calendly-inline-widget h-[1150px] w-full sm:h-[1050px] md:h-[760px]"
        data-url={calendlyEmbed}
      >
      </div>
    </div>

    <p class="mt-5 font-body text-sm text-muted">
      Calendar not loading?
      <a
        href={BOOKING_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="text-forest underline underline-offset-4"
      >Open the booking page directly</a>.
    </p>
  </Section>

  <!-- ==================================================== What happens next -->
  <Section space="normal">
    <div class="rounded-2xl border border-line px-6 py-10 md:px-12 md:py-14">
      <h2 class="font-display text-sub text-ink" data-reveal="line">After you book.</h2>
      <ol class="mt-8 grid gap-8 md:mt-10 md:grid-cols-3 md:gap-10">
        <li data-reveal="rise">
          <span class="block font-display text-[2rem] leading-none text-forest/25">01</span>
          <p class="mt-4 font-body text-[0.95rem] leading-relaxed text-muted">
            You receive a confirmation and a short preparation guide — what to bring, and what not
            to worry about.
          </p>
        </li>
        <li data-reveal="rise">
          <span class="block font-display text-[2rem] leading-none text-forest/25">02</span>
          <p class="mt-4 font-body text-[0.95rem] leading-relaxed text-muted">
            We agree the package and the backdrops beforehand, by mail or phone. Nothing has to be
            decided at the moment of booking.
          </p>
        </li>
        <li data-reveal="rise">
          <span class="block font-display text-[2rem] leading-none text-forest/25">03</span>
          <p class="mt-4 font-body text-[0.95rem] leading-relaxed text-muted">
            You arrive without rush. The first minutes belong to your animal.
          </p>
        </li>
      </ol>
      <p class="mt-8 font-body text-sm text-ink/45">
        [Payment, deposit and rescheduling policy TO BE SUPPLIED — the copy above assumes no online
        payment.]
      </p>
    </div>
  </Section>

  <!-- ====================================================== Questions first -->
  <Section space="normal">
    <div class="mx-auto max-w-[44rem] text-center">
      <h2 class="text-section leading-[1.08] text-ink" data-reveal="line">Questions first?</h2>
      <p
        class="mt-6 font-body text-[1.0625rem] leading-relaxed text-muted md:text-lg"
        data-reveal="rise"
      >
        A nervous animal, an unusual pet, a session at your home, a present for someone else —
        reach us however suits you. We answer personally, usually the same day.
      </p>
    </div>

    <ContactCards class="mt-12 md:mt-16" />
  </Section>

  <!-- ======================================================= The studio -->
  <Section space="normal">
    <div class="grid gap-10 border-t border-line pt-14 md:grid-cols-2 md:gap-16 md:pt-16">
      <div>
        <h2 class="text-section text-ink" data-reveal="line">The studio.</h2>

        <address class="mt-8 space-y-6 font-body not-italic" data-reveal="rise">
          <a
            href={STUDIO.mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="group block text-lg leading-relaxed text-ink transition-colors hover:text-forest"
          >
            <span class="block">{STUDIO.name}</span>
            <span class="block">{STUDIO.street}</span>
            <span class="block">{STUDIO.postcode} {STUDIO.city}</span>
            <span class="block">{STUDIO.country}</span>
            <span
              class="mt-2 inline-flex items-center gap-2 font-body text-sm text-forest underline-offset-4 group-hover:underline"
            >
              Open in Google Maps
              <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
            </span>
          </a>

          <p class="text-muted">
            <span class="block text-sm text-ink">Parking and accessibility</span>
            {STUDIO.parking}
          </p>

          <!-- Phone and mail are three cards up; repeating them here would
               only make the page look like it has six ways in, not three. -->
          <p>
            <a href={STUDIO.instagramUrl} class="text-forest underline-offset-4 hover:underline">
              Instagram {STUDIO.instagram}
            </a>
          </p>
        </address>

        <div class="mt-10" data-reveal="rise">
          <BookButton block />
        </div>
      </div>

      <MapEmbed class="h-64 rounded-xl md:h-full md:min-h-[22rem]" link />
    </div>
  </Section>
</Layout>

<!-- Calendly's own widget script. Deferred, and the page still works without it. -->
<script is:inline async src="https://assets.calendly.com/assets/external/widget.js"></script>
