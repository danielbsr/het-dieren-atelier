---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import PackageCards from '../components/PackageCards.astro';
import Portrait from '../components/Portrait.astro';
import Interior from '../components/Interior.astro';
import Faq from '../components/Faq.astro';
import ClosingCta from '../components/ClosingCta.astro';
import BookButton from '../components/BookButton.astro';
import { photo } from '../data/photos';
import { packagesSchema } from '../data/schema';
import {
  COMPARISON,
  CTA,
  EXTRA_PORTRAIT,
  FAQ_BOOKING,
  FEATURED_LABEL,
  ON_LOCATION,
  PACKAGES,
  PACKAGE_NOTE,
} from '../data/site';
---

<Layout
  title="Dierenfotoshoot & tarieven — vanaf €249"
  description="Drie studiopakketten voor een dierenfotoshoot: Essential €249, Signature €379 en Collection €549. Elk max. 45 minuten. Locatieportret bij jou thuis €695."
  schema={[packagesSchema()]}
>
  <PageHeader
    eyebrow="Fotoshoot & tarieven"
    title="Fotoshoot & tarieven."
    intro="Drie pakketten in de studio, met één verschil: het aantal professioneel bewerkte portretten. Elke studiofotoshoot duurt maximaal 45 minuten. En er is een vierde optie, waarbij de studio naar jou toe komt."
  />

  <!-- Pakketten -->
  <Section space="normal">
    <PackageCards cta={false} />
    <p
      class="mx-auto mt-12 max-w-[46rem] text-center font-body text-[1rem] leading-relaxed text-muted md:mt-14 md:text-[1.05rem]"
      data-reveal="rise"
    >
      {PACKAGE_NOTE}
    </p>
    <div class="mt-9 text-center md:mt-10" data-reveal="rise">
      <BookButton block class="mx-auto max-w-sm" />
    </div>
  </Section>

  <!-- Volledige vergelijking -->
  <Section space="normal">
    <h2 class="text-section text-ink" data-reveal="line">Regel voor regel vergeleken.</h2>
    <p class="mt-4 font-body text-sm text-muted md:hidden" data-reveal="rise">
      Veeg de tabel opzij om alle drie te zien.
    </p>

    <div class="-mx-6 mt-8 overflow-x-auto px-6 md:mx-0 md:mt-16 md:px-0" data-reveal="rise">
      <table class="w-full min-w-[44rem] border-collapse text-left">
        <caption class="sr-only">
          Vergelijking van de pakketten Essential, Signature en Collection
        </caption>
        <thead>
          <tr class="border-b border-forest/25">
            <th scope="col" class="py-5 pr-6 font-body text-sm font-medium text-muted">
              <span class="sr-only">Onderdeel</span>
            </th>
            {
              PACKAGES.map((pkg) => (
                <th scope="col" class="py-5 pr-6 align-bottom">
                  <span class="block font-display text-xl text-ink">{pkg.name}</span>
                  {pkg.featured && (
                    <span class="mt-2 inline-block rounded-full bg-lime px-3 py-0.5 font-body text-[0.65rem] font-medium uppercase tracking-[0.14em] text-forest-deep">
                      {FEATURED_LABEL}
                    </span>
                  )}
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            COMPARISON.map((row) => (
              <tr class="border-b border-line">
                <th scope="row" class="py-5 pr-6 font-body text-[0.95rem] font-normal text-muted">
                  {row.label}
                </th>
                {row.values.map((value, i) => (
                  <td
                    class={`py-5 pr-6 font-body text-[0.95rem] ${
                      i === 1 ? 'text-ink' : 'text-ink/80'
                    }`}
                  >
                    {value}
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p
      class="mt-8 max-w-[46rem] font-body text-[0.95rem] leading-relaxed text-muted"
      data-reveal="rise"
    >
      Het Locatieportret staat buiten deze tabel: tot 1 uur fotografie bij jou op locatie, 2
      professioneel bewerkte portretten en maximaal 2 huisdieren voor dezelfde prijs.
    </p>
  </Section>

  <!--
    Het Locatieportret is de duurste optie en had tot nu toe geen enkel
    beeld. Twee foto's van een echte locatiefotoshoot doen hier meer dan
    nog een alinea: ze laten zien dat "de mobiele studio" geen figuurlijke
    uitdrukking is.
  -->
  <Section space="normal">
    <div class="grid items-center gap-8 md:grid-cols-2 md:gap-16">
      <Interior
        photo={ON_LOCATION.photoWide}
        alt={ON_LOCATION.wideAlt}
        ratio="landscape"
        sizes="(min-width: 768px) 50vw, 100vw"
      />
      <div>
        <p class="eyebrow" data-reveal="rise">{ON_LOCATION.eyebrow}</p>
        <h2 class="mt-5 text-section leading-[1.08] text-ink" data-reveal="line">
          {ON_LOCATION.blurb}
        </h2>
        <p
          class="mt-6 max-w-[34rem] font-body text-[1.05rem] leading-relaxed text-muted"
          data-reveal="rise"
        >
          {ON_LOCATION.intro} In de tuin, op het strand of gewoon in de woonkamer — we werken waar
          jouw dier zich het prettigst voelt.
        </p>
        <p class="mt-4 font-body text-sm text-muted" data-reveal="rise">
          {ON_LOCATION.priceNote}
        </p>
      </div>
    </div>

    <Interior
      photo={ON_LOCATION.photo}
      alt={ON_LOCATION.alt}
      ratio="wide"
      sizes="(min-width: 1200px) 1120px, 100vw"
      class="mt-8 md:mt-12"
    />
  </Section>

  <!-- Wat "meerdere achtergronden" oplevert -->
  <Section space="tight">
    <div class="grid grid-cols-3 gap-3 md:gap-6">
      <Portrait
        tone="sage"
        src={photo('noor')}
        subject="bengaal"
        animal="cat"
        sizes="(min-width: 768px) 355px, 33vw"
        ratio="square"
        hover
      />
      <Portrait
        tone="caramel"
        src={photo('knabbel')}
        subject="cavia"
        animal="guineapig"
        sizes="(min-width: 768px) 355px, 33vw"
        ratio="square"
        hover
      />
      <Portrait
        tone="midnight"
        src={photo('storm')}
        subject="border collie"
        animal="dog"
        sizes="(min-width: 768px) 355px, 33vw"
        ratio="square"
        hover
      />
    </div>
    <p class="mt-5 font-body text-sm text-muted" data-reveal="rise">
      De achtergrond wordt gekozen bij het dier — vacht, ogen, karakter. Bij Signature en
      Collection kies je uit meerdere achtergronden binnen dezelfde fotoshoot.
    </p>
  </Section>

  <!-- Extra portretten -->
  <Section space="normal">
    <div
      class="grid gap-6 rounded-2xl border border-line p-8 md:grid-cols-[1fr_auto] md:items-center md:gap-12 md:p-10"
      data-reveal="rise"
    >
      <div>
        <h2 class="font-display text-2xl text-ink">{EXTRA_PORTRAIT.label}</h2>
        <p class="mt-3 max-w-[40rem] font-body text-[0.95rem] leading-relaxed text-muted">
          {EXTRA_PORTRAIT.body}
        </p>
      </div>
      <p class="font-display text-[2.25rem] leading-none text-forest">{EXTRA_PORTRAIT.price}</p>
    </div>
  </Section>

  <!-- Welk pakket past? -->
  <Section space="normal">
    <h2 class="text-section text-ink" data-reveal="line">Welk pakket past bij jou?</h2>
    <dl class="mt-12 space-y-10 md:mt-14">
      {
        PACKAGES.map((pkg) => (
          <div
            class="grid gap-3 border-t border-line pt-8 md:grid-cols-[10rem_1fr] md:gap-10"
            data-reveal="rise"
          >
            <dt class="font-display text-xl text-forest">{pkg.name}</dt>
            <dd class="max-w-[44rem] font-body text-[1.05rem] leading-relaxed text-muted">
              {pkg.guidance}
            </dd>
          </div>
        ))
      }

      <div
        class="grid gap-3 border-t border-line pt-8 md:grid-cols-[10rem_1fr] md:gap-10"
        data-reveal="rise"
      >
        <dt class="font-display text-xl text-forest">{ON_LOCATION.name}</dt>
        <dd class="max-w-[44rem] font-body text-[1.05rem] leading-relaxed text-muted">
          {ON_LOCATION.guidance}
        </dd>
      </div>
    </dl>

    <div class="mt-12 text-center md:mt-14" data-reveal="rise">
      <BookButton block class="mx-auto max-w-sm" />
    </div>
  </Section>

  <!-- Boeken & betalen -->
  <Section space="normal">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,20rem)_1fr] lg:gap-20">
      <div>
        <h2 class="text-section text-ink" data-reveal="line">Boeken & betalen.</h2>
        <a
          href={`${CTA.process.href}#veelgestelde-vragen`}
          class="group mt-6 inline-flex items-center gap-2 font-body text-forest underline-offset-4 hover:underline lg:mt-8"
          data-reveal="rise"
        >
          Alle veelgestelde vragen
          <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
        </a>
      </div>
      <Faq items={FAQ_BOOKING} />
    </div>
  </Section>

  <ClosingCta
    headline="Kies jouw pakket."
    body="Kies een datum in de agenda — de rest gebeurt rustig, in de studio of bij jou op locatie."
    tone="taupe"
    photo="daan"
    animal="dog"
    subject="labrador"
  />
</Layout>
